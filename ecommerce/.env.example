# Copiá este archivo como ".env" y completá los valores.
# El archivo .env NO se sube a Git.

# --- Django ---
# Generar una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Separados por coma, ej: fotografiavitale.com,www.fotografiavitale.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Separados por coma, con esquema, ej: https://fotografiavitale.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Mercado Pago (para la fase de integración de cobros) ---
# Se obtienen en https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
