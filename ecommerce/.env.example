# Copiá este archivo como ".env" y completá los valores.
# El archivo .env NUNCA se sube a Git.

# --- Django ---
# En producción es OBLIGATORIO generar una clave secreta propia:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# En desarrollo local: True
# En producción en servidor: False
DJANGO_DEBUG=True

# Dominios permitidos separados por coma:
# Desarrollo: 127.0.0.1,localhost
# Producción ej: fotografiavitale.com,www.fotografiavitale.com,tu-app.onrender.com,tu-app.up.railway.app
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Requerido en producción si usás formularios o admin bajo HTTPS.
# Dominios con esquema (https://) separados por coma:
# ej: https://fotografiavitale.com,https://tu-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Mercado Pago (para la fase futura de integración de cobros) ---
# Se obtienen en https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- EnvioPack ---
ENVIOPACK_API_KEY=
ENVIOPACK_SECRET_KEY=

